			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Response is a valid JSON\", function () {",
									"    pm.response.to.be.json;",
									"});",
									"pm.test(\"Status is ok\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"ok\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Records",
			"item": [
				{
					"name": "List Runs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/records/runs?limit=10&offset=0",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"records",
								"runs"
							],
							"query": [
								{
									"key": "limit",
									"value": "10",
									"description": "Number of results (1-500)"
								},
								{
									"key": "offset",
									"value": "0",
									"description": "Pagination offset"
								}
							]
						}
					},
					"response": [],
